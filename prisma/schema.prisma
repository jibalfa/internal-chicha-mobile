generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  username            String               @unique
  password            String
  role                String               @default("CASHIER") // OWNER, CASHIER
  phone               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  sales               Sale[]
  digitalTransactions DigitalTransaction[]
  inventoryMovements  InventoryMovement[]
  expenses            Expense[]
  voucherDebts        VoucherDebt[]

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Supplier {
  id            String    @id @default(cuid())
  name          String
  phone         String?
  address       String?
  contactPerson String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]

  @@map("suppliers")
}

model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  name               String
  categoryId         String
  brand              String?
  costPrice          Float               @default(0)
  sellingPrice       Float               @default(0)
  stock              Int                 @default(0)
  minStock           Int                 @default(5)
  supplierId         String?
  type               String              @default("ACCESSORY") // ACCESSORY, GENERAL
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]

  @@map("products")
}

model InventoryMovement {
  id            String       @id @default(cuid())
  productId     String
  type          String       // INITIAL_STOCK, PURCHASE, SALE, ADJUSTMENT, RETURN
  quantity      Int
  previousStock Int
  newStock      Int
  referenceId   String?
  notes         String?
  createdById   String?
  createdAt     DateTime     @default(now())

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy     User?        @relation(fields: [createdById], references: [id])

  @@map("inventory_movements")
}

model Voucher {
  id           String            @id @default(cuid())
  operator     String
  nominal      String
  costPrice    Float             @default(0)
  sellingPrice Float             @default(0)
  stock        Int               @default(0)
  minStock     Int               @default(10)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  movements    VoucherMovement[]
  saleItems    SaleItem[]
  debtItems    VoucherDebtItem[]

  @@unique([operator, nominal])
  @@map("vouchers")
}

model VoucherMovement {
  id            String              @id @default(cuid())
  voucherId     String
  type          String              // INITIAL_STOCK, STOCK_IN, SOLD, ADJUSTMENT
  quantity      Int
  previousStock Int
  newStock      Int
  referenceId   String?
  notes         String?
  createdAt     DateTime            @default(now())

  voucher       Voucher             @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@map("voucher_movements")
}

model VoucherDebt {
  id            String            @id @default(cuid())
  debtNumber    String            @unique
  customerName  String
  customerPhone String?
  totalAmount   Float             @default(0)
  status        String            @default("UNPAID") // UNPAID, PAID, CANCELLED
  dueDate       DateTime?
  paidAt        DateTime?
  paidMethod    String?           // CASH, TRANSFER, QRIS
  notes         String?
  cashierId     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  cashier       User?             @relation(fields: [cashierId], references: [id])
  items         VoucherDebtItem[]

  @@map("voucher_debts")
}

model VoucherDebtItem {
  id          String       @id @default(cuid())
  debtId      String
  voucherId   String
  quantity    Int          @default(1)
  costPrice   Float        @default(0)
  unitPrice   Float        @default(0)
  subtotal    Float        @default(0)
  profit      Float        @default(0)

  debt        VoucherDebt  @relation(fields: [debtId], references: [id], onDelete: Cascade)
  voucher     Voucher      @relation(fields: [voucherId], references: [id])

  @@map("voucher_debt_items")
}

model DigitalProduct {
  id           String               @id @default(cuid())
  category     String               // PULSA, PLN, DATA, GAME, EMONEY
  provider     String
  name         String
  nominal      Float                @default(0)
  costPrice    Float                @default(0)
  sellingPrice Float                @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  transactions DigitalTransaction[]

  @@map("digital_products")
}

model DigitalTransaction {
  id                String         @id @default(cuid())
  trxNumber         String         @unique
  digitalProductId  String
  destinationNumber String
  costPrice         Float          @default(0)
  sellingPrice      Float          @default(0)
  profit            Float          @default(0)
  status            String         @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  notes             String?
  cashierId         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  digitalProduct    DigitalProduct @relation(fields: [digitalProductId], references: [id])
  cashier           User?          @relation(fields: [cashierId], references: [id])

  @@map("digital_transactions")
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  totalAmount   Float         @default(0)
  discount      Float         @default(0)
  finalAmount   Float         @default(0)
  paymentMethod String        @default("CASH") // CASH, TRANSFER, QRIS
  cashGiven     Float         @default(0)
  changeGiven   Float         @default(0)
  notes         String?
  cashierId     String?
  createdAt     DateTime      @default(now())

  cashier       User?         @relation(fields: [cashierId], references: [id])
  items         SaleItem[]

  @@map("sales")
}

model SaleItem {
  id           String       @id @default(cuid())
  saleId       String
  itemType     String       @default("PRODUCT") // PRODUCT, VOUCHER
  productId    String?
  voucherId    String?
  itemName     String
  quantity     Int          @default(1)
  costPrice    Float        @default(0)
  unitPrice    Float        @default(0)
  subtotal     Float        @default(0)
  profit       Float        @default(0)

  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id])
  voucher      Voucher?     @relation(fields: [voucherId], references: [id])

  @@map("sale_items")
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime        @default(now())
  category    String          @default("OPERATIONAL") // ELECTRICITY, INTERNET, RENT, OPERATIONAL, TRANSPORT, SALARY, OTHER
  description String
  amount      Float           @default(0)
  notes       String?
  createdById String?
  createdAt   DateTime        @default(now())

  createdBy   User?           @relation(fields: [createdById], references: [id])

  @@map("expenses")
}

model StoreSetting {
  id            String   @id @default("default_store_setting")
  name          String   @default("CHICHA MOBILE")
  tagline       String?  @default("Pusat Aksesoris & Pulsa")
  address       String?  @default("Jl. Toko ChiCha Mobile")
  phone         String?  @default("0812-3456-7890")
  receiptFooter String?  @default("Barang yang dibeli tidak dapat ditukar/dikembalikan. Terima kasih!")
  printCopies   Int      @default(1)
  paperWidth    String   @default("58mm")
  autoPrint     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("store_settings")
}
